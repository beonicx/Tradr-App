{
    "name": "TradingApp",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "android": "react-native run-android",
        "ios": "react-native run-ios",
        "start": "react-native start",
        "start:clean": "react-native start --reset-cache",
        "lint": "eslint .",
        "test": "jest",
        "android:dev": "cp .env.development .env && react-native run-android",
        "android:staging": "cp .env.staging .env && react-native run-android",
        "android:prod": "cp .env.production .env && react-native run-android --variant=release",
        "ios:dev": "cp .env.development .env && react-native run-ios",
        "ios:staging": "cp .env.staging .env && react-native run-ios",
        "ios:prod": "cp .env.production .env && react-native run-ios --configuration Release",
        "env:dev": "cp .env.development .env",
        "env:staging": "cp .env.staging .env",
        "env:prod": "cp .env.production .env",
        "metro": "./scripts/start-metro.sh dev",
        "metro:dev": "./scripts/start-metro.sh dev",
        "metro:staging": "./scripts/start-metro.sh staging",
        "metro:prod": "./scripts/start-metro.sh prod",
        "ios:only": "./scripts/start-ios.sh current",
        "android:only": "./scripts/start-android.sh current",
        "start:multi": "react-native start --port 8081",
        "both": "./scripts/run-both.sh dev",
        "both:dev": "./scripts/run-both.sh dev",
        "both:staging": "./scripts/run-both.sh staging",
        "both:prod": "./scripts/run-both.sh prod",
        "both:tmux": "./scripts/run-both-tmux.sh dev",
        "both:clean": "cp .env.development .env && npm run start:clean",
        "stop:all": "./scripts/stop-all.sh",
        "status": "./scripts/check-status.sh",
        "fix:ios": "./scripts/fix-ios.sh",
        "prestart:ios": "npm run env:dev",
        "prestart:android": "npm run env:dev"
    },
    "dependencies": {
        "@react-native-async-storage/async-storage": "^1.21.0",
        "@react-navigation/bottom-tabs": "^6.5.11",
        "@react-navigation/native": "^6.1.9",
        "@react-navigation/stack": "^6.3.20",
        "@reduxjs/toolkit": "^1.9.7",
        "axios": "^1.6.0",
        "date-fns": "^2.30.0",
        "nativewind": "^2.0.11",
        "react": "18.2.0",
        "react-native": "0.72.6",
        "react-native-chart-kit": "^6.12.0",
        "react-native-dotenv": "^3.4.11",
        "react-native-gesture-handler": "^2.12.1",
        "react-native-haptic-feedback": "^2.2.0",
        "react-native-linear-gradient": "^2.8.3",
        "react-native-modal": "^13.0.1",
        "react-native-razorpay": "^2.2.6",
        "react-native-reanimated": "3.6.1",
        "react-native-safe-area-context": "^4.7.4",
        "react-native-screens": "^3.25.0",
        "react-native-skeleton-placeholder": "^5.2.4",
        "react-native-svg": "^14.1.0",
        "react-native-toast-message": "^2.2.0",
        "react-native-vector-icons": "^10.0.3",
        "react-redux": "^8.1.3",
        "socket.io-client": "^4.7.2"
    },
    "devDependencies": {
        "@babel/core": "^7.20.0",
        "@babel/preset-env": "^7.20.0",
        "@babel/runtime": "^7.20.0",
        "@react-native/eslint-config": "^0.72.2",
        "@react-native/metro-config": "^0.72.11",
        "babel-jest": "^29.2.1",
        "eslint": "^8.19.0",
        "jest": "^29.2.1",
        "metro-react-native-babel-preset": "0.76.8",
        "prettier": "^2.4.1",
        "react-test-renderer": "18.2.0",
        "tailwindcss": "3.3.2"
    },
    "jest": {
        "preset": "react-native"
    }
}
